# Copy to .env (git-ignored) and fill in. Nothing here is needed for the local test suite.
REGISTRY_LANDING_S3=s3://<bucket>/<prefix>/landing      # only for tools/sample_landing.py
REGISTRY_ALERT_WEBHOOK=https://hooks.slack.com/services/<...>  # optional, non-fatal alerts
REGISTRY_PSEUDONYM_KEY=<long random string>              # keyed hash for personal ids
REGISTRY_USD_PER_DBU=0.35                                # your serverless jobs list price
BUNDLE_VAR_landing_root=/Volumes/<catalog>/landing/files
BUNDLE_VAR_publish_root=/Volumes/<catalog>/publish/site
BUNDLE_VAR_alert_email=<you@your-domain>
